# Copiar a backend/.env y ajustar.
# Nunca subir .env al repositorio.

JWT_SECRET=cambiar-por-secreto-largo-en-produccion-tienda

# MySQL — base Tienda
DB_NAME=tienda
DB_USER=root
DB_PASS=
DB_HOST=localhost
DB_PORT=3306

# Opcional: log SQL de Sequelize (1 = activo)
# DB_LOGGING=0

# Servidor HTTP
PORT=3004
API_PREFIX=tiendaapi

# Zona horaria por defecto (IANA)
# APP_TIMEZONE=America/Guayaquil

# Gestor Raptor Solutions (pull manual opcional; runtime usa app_entitlements local)
# Dev:  http://127.0.0.1:3000/raptorsolutions/api
# Prod: https://aplicaciones.marianosamaniego.edu.ec/raptorsolutions/api
SUBSCRIPTION_API_URL=http://127.0.0.1:3000/raptorsolutions/api
SUBSCRIPTION_API_KEY=

# Debe coincidir con Apps.entitlement_secret del gestor para esta app
GESTOR_SYNC_SECRET=tienda_gestor_sync_local_dev
# Producción: usá el secreto de Tienda configurado en el gestor.

# Webhook / métricas hacia el gestor
RAPTOR_WEBHOOK_HOST=localhost
RAPTOR_WEBHOOK_PORT=3000
RAPTOR_WEBHOOK_PROTOCOL=http
# RAPTOR_LOAD_METRICS_ENABLED=1
